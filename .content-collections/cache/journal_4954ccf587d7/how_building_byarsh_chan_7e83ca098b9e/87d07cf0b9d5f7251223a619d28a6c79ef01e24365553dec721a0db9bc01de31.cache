"var Component=(()=>{var p=Object.create;var r=Object.defineProperty;var m=Object.getOwnPropertyDescriptor;var g=Object.getOwnPropertyNames;var u=Object.getPrototypeOf,y=Object.prototype.hasOwnProperty;var f=(t,e)=>()=>(e||t((e={exports:{}}).exports,e),e.exports),w=(t,e)=>{for(var i in e)r(t,i,{get:e[i],enumerable:!0})},s=(t,e,i,a)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let o of g(e))!y.call(t,o)&&o!==i&&r(t,o,{get:()=>e[o],enumerable:!(a=m(e,o))||a.enumerable});return t};var b=(t,e,i)=>(i=t!=null?p(u(t)):{},s(e||!t||!t.__esModule?r(i,\"default\",{value:t,enumerable:!0}):i,t)),I=t=>s(r({},\"__esModule\",{value:!0}),t);var h=f((T,l)=>{l.exports=_jsx_runtime});var v={};w(v,{default:()=>c});var n=b(h());function d(t){let e={blockquote:\"blockquote\",p:\"p\",...t.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.p,{children:\"For a long time, I believed a website had to do everything.\"}),`\n`,(0,n.jsx)(e.p,{children:\"It had to be fast. Beautiful. Full of animations. Packed with features. Optimised for every trend. Every time I opened another portfolio or personal website, I felt the pressure to add one more section, one more effect, one more reason for someone to stay.\"}),`\n`,(0,n.jsx)(e.p,{children:\"But somewhere during the process of building ByArsh, my thinking changed.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I realised that the internet doesn't always need another loud website.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Sometimes it needs a quiet one.\"}),`\n`,(0,n.jsxs)(e.blockquote,{children:[`\n`,(0,n.jsx)(e.p,{children:\"The internet doesn't always need another loud website. Sometimes it needs a quiet one.\"}),`\n`]}),`\n`,(0,n.jsx)(e.p,{children:\"That single thought slowly became the foundation of everything I was building.\"}),`\n`,(0,n.jsx)(e.p,{children:'Instead of asking, \"What else can I add?\", I started asking, \"What can I remove?\"'}),`\n`,(0,n.jsx)(e.p,{children:\"The answer was surprising.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I removed unnecessary animations. I simplified layouts. I stopped designing pages to impress people and started designing them to make someone feel comfortable.\"}),`\n`,(0,n.jsx)(e.p,{children:\"ByArsh slowly transformed from a developer portfolio into a digital journal.\"}),`\n`,(0,n.jsx)(e.p,{children:\"A place where software engineering could exist alongside books, travel stories, quiet reflections, and everyday learning.\"}),`\n`,(0,n.jsx)(e.p,{children:\"That balance felt more authentic than separating my professional life from my personal interests.\"}),`\n`,(0,n.jsx)(e.p,{children:\"As I continued building, I realised another important lesson.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The internet remembers everything we publish.\"}),`\n`,(0,n.jsx)(e.p,{children:\"If that is true, I wanted my small corner of it to represent the person I genuinely hope to become\\u2014not just the developer I am today.\"}),`\n`,(0,n.jsx)(e.p,{children:\"That meant choosing thoughtful writing over constant posting.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Quality over quantity.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Consistency over perfection.\"}),`\n`,(0,n.jsx)(e.p,{children:\"And honesty over trends.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Building ByArsh also reminded me that growth isn't always visible.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Many evenings ended with nothing more than adjusting typography, rewriting a paragraph, or moving a single section a few pixels higher.\"}),`\n`,(0,n.jsx)(e.p,{children:\"None of those changes were dramatic.\"}),`\n`,(0,n.jsx)(e.p,{children:\"But together they shaped the experience I wanted someone to have when visiting this website.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Perhaps the biggest lesson wasn't about design or development at all.\"}),`\n`,(0,n.jsx)(e.p,{children:\"It was about creating something with patience.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The internet moves incredibly fast.\"}),`\n`,(0,n.jsx)(e.p,{children:\"New technologies appear every month.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Design trends change almost every season.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Algorithms reward speed.\"}),`\n`,(0,n.jsx)(e.p,{children:\"But meaningful work rarely happens quickly.\"}),`\n`,(0,n.jsx)(e.p,{children:\"ByArsh became my reminder that it's perfectly acceptable to build slowly, as long as you're building intentionally.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Today, I no longer think of this website as a portfolio.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I think of it as a collection of everything I'm learning.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The projects I build.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The books that challenge my thinking.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The places I travel.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The mistakes I make.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The ideas that stay with me.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I hope that years from now, when I look back through these pages, I'll see not only the work I've created, but also the person I was becoming while creating it.\"}),`\n`,(0,n.jsx)(e.p,{children:\"If someone else finds a little inspiration here along the way, that's simply a beautiful bonus.\"})]})}function c(t={}){let{wrapper:e}=t.components||{};return e?(0,n.jsx)(e,{...t,children:(0,n.jsx)(d,{...t})}):d(t)}return I(v);})();\n;return Component;"