"var Component=(()=>{var p=Object.create;var r=Object.defineProperty;var m=Object.getOwnPropertyDescriptor;var u=Object.getOwnPropertyNames;var g=Object.getPrototypeOf,y=Object.prototype.hasOwnProperty;var w=(t,e)=>()=>(e||t((e={exports:{}}).exports,e),e.exports),f=(t,e)=>{for(var o in e)r(t,o,{get:e[o],enumerable:!0})},s=(t,e,o,i)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let a of u(e))!y.call(t,a)&&a!==o&&r(t,a,{get:()=>e[a],enumerable:!(i=m(e,a))||i.enumerable});return t};var b=(t,e,o)=>(o=t!=null?p(g(t)):{},s(e||!t||!t.__esModule?r(o,\"default\",{value:t,enumerable:!0}):o,t)),v=t=>s(r({},\"__esModule\",{value:!0}),t);var c=w((x,h)=>{h.exports=_jsx_runtime});var k={};f(k,{default:()=>l});var n=b(c());function d(t){let e={blockquote:\"blockquote\",p:\"p\",...t.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.p,{children:\"I've never believed that books change your life overnight.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Instead, I think they change it quietly.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Sometimes it's a single sentence that stays in your mind for weeks. Sometimes it's an idea that slowly changes the way you approach work, relationships, or even yourself. Those changes are often so gradual that you don't notice them until much later.\"}),`\n`,(0,n.jsx)(e.p,{children:\"That's what makes reading special to me.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Every book becomes a conversation with someone who has spent years organising their thoughts into a few hundred pages. Whether I agree with every idea or not, I always come away with a new perspective.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Over time, I realised I wasn't reading to finish books anymore.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I was reading to understand people.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Every author sees the world through a different lens. Some write with optimism, others with curiosity, and some challenge assumptions I didn't even realise I had. Each perspective adds something valuable, even when it contradicts my own.\"}),`\n`,(0,n.jsx)(e.p,{children:\"One of the most surprising lessons reading has taught me is the importance of slowing down.\"}),`\n`,(0,n.jsx)(e.p,{children:\"In a world that rewards speed and constant updates, books ask for something different.\"}),`\n`,(0,n.jsx)(e.p,{children:\"They ask for attention.\"}),`\n`,(0,n.jsx)(e.p,{children:\"For patience.\"}),`\n`,(0,n.jsx)(e.p,{children:\"For presence.\"}),`\n`,(0,n.jsx)(e.p,{children:\"And in return, they offer something social media rarely can\\u2014depth.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Reading has also changed the way I solve problems.\"}),`\n`,(0,n.jsx)(e.p,{children:\"As a software engineer, it's easy to think every challenge has a technical solution. Books remind me that the most interesting problems are often human ones. They encourage empathy, curiosity, and the ability to look beyond the obvious answer.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Some books have encouraged me to think bigger.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Others have reminded me to stay grounded.\"}),`\n`,(0,n.jsx)(e.p,{children:\"A few have challenged ideas I was completely convinced were true.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Those are often the books I'm most grateful for.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Looking back, I don't remember every chapter of every book I've read.\"}),`\n`,(0,n.jsx)(e.p,{children:\"But I do remember how certain books made me feel.\"}),`\n`,(0,n.jsx)(e.p,{children:\"More curious.\"}),`\n`,(0,n.jsx)(e.p,{children:\"More patient.\"}),`\n`,(0,n.jsx)(e.p,{children:\"More thoughtful.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Those quiet changes are difficult to measure, yet they've had a lasting influence on the person I'm becoming.\"}),`\n`,(0,n.jsx)(e.p,{children:\"That's why this website includes a Library section.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Not because I've read hundreds of books.\"}),`\n`,(0,n.jsx)(e.p,{children:\"But because every meaningful book leaves behind a small piece of itself, and collecting those pieces has become part of my own journey.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I hope that as I continue reading, this collection grows\\u2014not as a list of completed books, but as a record of ideas that helped shape the way I think.\"}),`\n`,(0,n.jsxs)(e.blockquote,{children:[`\n`,(0,n.jsx)(e.p,{children:\"The best books don't simply give us answers\\u2014they quietly teach us how to ask better questions.\"}),`\n`]})]})}function l(t={}){let{wrapper:e}=t.components||{};return e?(0,n.jsx)(e,{...t,children:(0,n.jsx)(d,{...t})}):d(t)}return v(k);})();\n;return Component;"