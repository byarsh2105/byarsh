"var Component=(()=>{var p=Object.create;var a=Object.defineProperty;var m=Object.getOwnPropertyDescriptor;var u=Object.getOwnPropertyNames;var f=Object.getPrototypeOf,y=Object.prototype.hasOwnProperty;var g=(t,e)=>()=>(e||t((e={exports:{}}).exports,e),e.exports),w=(t,e)=>{for(var o in e)a(t,o,{get:e[o],enumerable:!0})},s=(t,e,o,i)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let r of u(e))!y.call(t,r)&&r!==o&&a(t,r,{get:()=>e[r],enumerable:!(i=m(e,r))||i.enumerable});return t};var b=(t,e,o)=>(o=t!=null?p(f(t)):{},s(e||!t||!t.__esModule?a(o,\"default\",{value:t,enumerable:!0}):o,t)),v=t=>s(a({},\"__esModule\",{value:!0}),t);var l=g((I,h)=>{h.exports=_jsx_runtime});var k={};w(k,{default:()=>c});var n=b(l());function d(t){let e={blockquote:\"blockquote\",p:\"p\",...t.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.p,{children:\"Before visiting Manali, winter was just another season to me.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Cold mornings, extra layers, and shorter days.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I had seen countless photographs of snow-covered mountains online, but I never imagined what it would feel like to stand in front of them myself.\"}),`\n`,(0,n.jsx)(e.p,{children:\"December changed that.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The journey began like many others\\u2014with excitement, a packed bag, and a camera ready to capture everything. But somewhere between the winding mountain roads and the first glimpse of snow, I realised this trip wasn't going to be remembered because of photographs alone.\"}),`\n`,(0,n.jsx)(e.p,{children:\"It was going to be remembered because of how it made me feel.\"}),`\n`,(0,n.jsx)(e.p,{children:\"There was something incredibly peaceful about the mountains.\"}),`\n`,(0,n.jsx)(e.p,{children:\"They didn't try to impress anyone.\"}),`\n`,(0,n.jsx)(e.p,{children:\"They simply existed.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The tall pine trees, the fresh air, the quiet roads, and the snow resting gently on rooftops created a kind of silence that is difficult to experience in everyday life.\"}),`\n`,(0,n.jsx)(e.p,{children:\"For the first time in a long while, I wasn't thinking about deadlines, notifications, or the next thing on my to-do list.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I was simply present.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Walking through the streets of Manali taught me something I didn't expect.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Life doesn't always need to move quickly.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Sometimes it's enough to slow your pace, hold a warm cup of tea, and watch people passing by while snow quietly falls around you.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Those ordinary moments became the most memorable ones.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I realised that travelling isn't always about checking famous places off a list.\"}),`\n`,(0,n.jsx)(e.p,{children:\"It's about allowing a place to leave a small mark on you.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Every conversation with a local shopkeeper, every quiet morning, every mountain view reminded me that happiness often lives in simple experiences.\"}),`\n`,(0,n.jsx)(e.p,{children:\"As someone who spends most days in front of a computer, surrounded by code and screens, this trip became a gentle reminder to step outside more often.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Nature has a way of resetting our thoughts.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The mountains don't solve our problems, but they give us enough distance to see them differently.\"}),`\n`,(0,n.jsx)(e.p,{children:\"When I returned home, I carried back more than photographs.\"}),`\n`,(0,n.jsx)(e.p,{children:\"I brought back a slower rhythm.\"}),`\n`,(0,n.jsx)(e.p,{children:\"A greater appreciation for silence.\"}),`\n`,(0,n.jsx)(e.p,{children:\"And a promise to myself that travel would always remain a part of my life\\u2014not as an escape, but as a way of staying curious about the world.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Some journeys become memories.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Others quietly become part of who you are.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Manali became both.\"}),`\n`,(0,n.jsxs)(e.blockquote,{children:[`\n`,(0,n.jsx)(e.p,{children:\"Some places leave footprints on our shoes. Others leave footprints on our hearts.\"}),`\n`]})]})}function c(t={}){let{wrapper:e}=t.components||{};return e?(0,n.jsx)(e,{...t,children:(0,n.jsx)(d,{...t})}):d(t)}return v(k);})();\n;return Component;"